# HaruDrive Environment Variables Template
# Salin file ini menjadi .env jika menjalankan secara lokal atau isi pada Cloudflare Dashboard / GitHub Secrets

# 1. Hugging Face Storage
HF_TOKEN=hf_your_huggingface_token_here
HF_REPO_ID=username/harudrive-data

# 2. Keamanan & Admin
ADMIN_PIN=123456
APP_PASSWORD=YourSecurePasswordHere

# 3. GitHub Actions Integration (Untuk Remote Cloud Mirror)
GITHUB_PAT=ghp_your_github_personal_access_token_here
GITHUB_REPO=username/haru-drive

# 4. Google Drive OAuth v3 (Untuk Colab & Cloud Mirror)
GDRIVE_CLIENT_ID=your_gdrive_client_id_here
GDRIVE_CLIENT_SECRET=your_gdrive_client_secret_here
GDRIVE_REFRESH_TOKEN=your_gdrive_refresh_token_here

# 5. Cloudflare Deploy (Opsional untuk CI/CD)
CLOUDFLARE_API_TOKEN=cfut_your_cloudflare_api_token_here
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
