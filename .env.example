# ==========================================
# 🌸 HaruDrive Environment Variables & Secrets
# ==========================================

# 1. Hugging Face Configuration
# HF_REPO_ID: The target dataset repo (e.g., IlhamRomadon297/harustorage)
HF_REPO_ID="username/harustorage"

# HF_TOKEN: Hugging Face User Access Token with 'Write' permission
# Generate from: https://huggingface.co/settings/tokens
HF_TOKEN="hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# 2. Application Security
# Access password required to log into HaruDrive
APP_PASSWORD="your-secure-password"

# 3. Cloud Mirror (GitHub Actions Integration)
# GITHUB_REPO: Your repository path (username/repo)
GITHUB_REPO="IlhamRomadon297/haru-drive"

# GITHUB_PAT: GitHub Personal Access Token (classic with 'repo' scope or fine-grained with Actions write)
# Generate from: https://github.com/settings/tokens
GITHUB_PAT="ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
